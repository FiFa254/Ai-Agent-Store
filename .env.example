# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Required to access the Admin Panel (product/stock management).
# Without this set, all admin write endpoints (create/update/delete product,
# resolve alert) are refused outright rather than left open. Set this to a
# strong, unique password before deploying.
ADMIN_PASSWORD="change-me-to-a-strong-password"

# MSSQL_CONNECTION_STRING: SQL Server database for products, sales, pending QR orders
# and stock alerts. Default: local SQL Server with your Windows login, database
# GroceryAI (created with its tables on first start). Uses ODBC Driver 17 or 18.
# MSSQL_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=GroceryAI;Trusted_Connection=yes;"

# SEED_DEMO_DATA: set to true to insert 10 demo products when the database is empty.
# SEED_DEMO_DATA="false"
