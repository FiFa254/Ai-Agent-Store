# Copy to .env and adjust. start.bat creates .env from this file on first run.

# Web port (http://localhost:PORT)
PORT=3000

# SQL Server database. Default: local SQL Server, your Windows login, database GroceryAI
# (created with its tables on first start). ODBC Driver 17 or 18 for SQL Server is required.
# MSSQL_CONNECTION_STRING="Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=GroceryAI;Trusted_Connection=yes;"

# Gemini API key for the storefront AI assistant (optional; without it the assistant does simple product search).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Staff session length in hours (sliding).
# SESSION_HOURS=12
