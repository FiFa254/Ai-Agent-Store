{
  "name": "grocerai-server",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --sourcemap --outfile=dist/index.cjs && node scripts/copy-migrations.mjs",
    "start": "node --enable-source-maps dist/index.cjs",
    "test": "tsx --tsconfig tsconfig.json --test --test-concurrency=1 tests/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "msnodesqlv8": "^5.5.0",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0"
  }
}
